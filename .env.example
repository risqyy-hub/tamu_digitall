# =============================================================
#  Buku Tamu Digital - Konfigurasi Lingkungan
#  Salin file ini menjadi .env lalu isi nilainya.
#  cp .env.example .env
# =============================================================

# --- Database ---
# Driver : mysql (XAMPP/MariaDB lokal) atau pgsql (Supabase PostgreSQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=buku_tamu_digital
DB_USER=root
DB_PASS=

# --- Supabase PostgreSQL (isi saat beralih ke Supabase) ---
# DB_DRIVER=pgsql
# DB_HOST=db.xxxxxxxxxxxxx.supabase.co      # Hostname proyek (bukan pooler)
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASS=password-database-supabase-anda
# DB_SSLMODE=require

# --- Aplikasi ---
# APP_URL dikosongkan agar BASE_URL dideteksi otomatis dari alamat lokal.
APP_URL=
APP_TIMEZONE=Asia/Jakarta
# APP_DEBUG=1 hanya untuk pengembangan (menampilkan detail error koneksi)
APP_DEBUG=1
