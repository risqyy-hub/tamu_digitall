# =============================================================
#  Buku Tamu Digital - Konfigurasi Lingkungan (TEMPLATE)
#  Salin file ini menjadi .env lalu isi nilainya.
#  cp .env.example .env
#  JANGAN meng-commit file .env (sudah masuk .gitignore).
# =============================================================

# --- Database ---
# Driver : mysql (XAMPP/MariaDB lokal) atau pgsql (Supabase PostgreSQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buku_tamu_digital
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Nama variabel lama (DB_NAME / DB_USER / DB_PASS) masih didukung sebagai cadangan
# bila file .env Anda belum diperbarui ke nama DB_DATABASE / DB_USERNAME / DB_PASSWORD.

# --- Supabase PostgreSQL (isi saat beralih ke Supabase) ---
# DB_DRIVER=pgsql
# DB_HOST=db.xxxxxxxxxxxxx.supabase.co      # Hostname proyek (bukan pooler)
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=password-database-supabase-anda
# DB_SSLMODE=require

# --- Aplikasi ---
# APP_URL dikosongkan agar BASE_URL dideteksi otomatis dari alamat lokal.
APP_URL=
APP_TIMEZONE=Asia/Jakarta
# APP_DEBUG=1 hanya untuk pengembangan (menampilkan detail error koneksi).
# Biarkan 0 untuk produksi agar detail koneksi tidak tampil ke pengguna.
APP_DEBUG=0
